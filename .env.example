# ESPN public endpoints; no personal API token required.
NODE47_HTTP_TIMEOUT=20
NODE47_HTTP_RETRIES=2

# Optional PostgreSQL backend (e.g. Supabase transaction pooler).
# When set, PostgreSQL is used instead of the local SQLite file.
# Keep the value in Render's secret environment variables; never commit credentials.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# SQLite is used only when DATABASE_URL is not set.
# NODE47_DATA_PATH=./data/node47.sqlite3
